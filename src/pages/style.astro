---
import Base from "../layouts/Base.astro";
import Lead from "../components/Lead.astro";
import GoDeeper from "../components/GoDeeper.astro";
import NoticeAside from "../components/NoticeAside.astro";
import NOfOneAside from "../components/NOfOneAside.astro";
import EvidenceTag from "../components/EvidenceTag.astro";
import NextSteps from "../components/NextSteps.astro";
import { url } from "../lib/url";
const colors = [
  ["Page", "var(--surface)"], ["Panel", "var(--surface-raised)"],
  ["Text", "var(--text)"], ["Secondary text", "var(--text-muted)"],
  ["Links", "var(--accent)"], ["Dividers", "var(--line)"],
];
const tiers = ["strong", "moderate", "preliminary", "practitioner-reported", "contested"] as const;
---
<Base title="Style guide" description="The shared typography, colors, and components used across Gently." crumbs={[]}>
  <h1 class="page-title">Style guide</h1>
  <Lead>One reading layout across the whole site. Warm neutral colors, clear links, and useful information before decoration.</Lead>
  <h2 class="text-2xl mt-10">Color</h2>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-4">
    {colors.map(([label, color]) => (
      <div><div class="h-16 rounded-soft" style={{ background: color, border: "1px solid var(--line)" }} /><p class="text-sm mt-1">{label}</p></div>
    ))}
  </div>
  <h2 class="text-2xl mt-10">Type and layout</h2>
  <div class="prose">
    <p>Fraunces for headings. Atkinson Hyperlegible Next for reading and navigation. Body text is 17px with a 1.7 line-height; the reading column is at most 43rem wide.</p>
    <p>Lists use dividers. Panels are reserved for tools and asides. No shadows, decorative illustrations, or automatic motion. The palette follows the reader's light or dark system setting.</p>
  </div>
  <h2 class="text-2xl mt-10">Evidence labels</h2>
  <p class="flex flex-wrap gap-2 mt-3">{tiers.map((tier) => <EvidenceTag tier={tier} />)}</p>
  <h2 class="text-2xl mt-10">Asides</h2>
  <NoticeAside><p>An optional exercise with a clear way to stop.</p></NoticeAside>
  <NOfOneAside><p>Personal experience stays separate from evidence.</p></NOfOneAside>
  <h2 class="text-2xl mt-10">Optional detail</h2>
  <GoDeeper><p>Supporting detail can go in a disclosure. Essential information stays visible.</p></GoDeeper>
  <NextSteps>
    <li><a href={url("start/")}>Read the introduction</a></li>
    <li><a href={url("about/criteria/")}>Evidence criteria</a></li>
    <li><a href={url("")}>Home</a></li>
  </NextSteps>
</Base>
