---
import Base from "../layouts/Base.astro";
import Lead from "../components/Lead.astro";
import TourList from "../components/TourList.astro";
import { url } from "../lib/url";
const sections = [
  { href: "practices/", title: "Try a short practice", description: "Simple exercises, usually two to five minutes. Choose what fits." },
  { href: "learn/", title: "Understand more", description: "Nervous system states, capacity, and how change happens. Plus people and research to learn from." },
  { href: "modalities/", title: "Explore approaches to support", description: "Therapies and body-based approaches, with evidence, costs, and practitioner directories." },
];
---
<Base title="Nervous system healing" description="A free guide to nervous system states, short practices, and approaches to support. Start with a five-part introduction.">
  <h1 class="page-title">Nervous system healing</h1>
  <Lead>Understand what you're feeling, learn what can help, and find a useful next step. A free guide, starting with the basics.</Lead>

  <section class="guide-section" aria-labelledby="tour-title">
    <div class="section-heading">
      <h2 id="tour-title">Start here</h2>
      <p>5 short steps · About 10 minutes</p>
    </div>
    <TourList />
    <p class="guide-note">Read in order, skip a step, or stop whenever you like.</p>
  </section>

  <section class="guide-section" aria-labelledby="explore-title">
    <div class="section-heading"><h2 id="explore-title">Or go straight to</h2></div>
    <ul class="entry-list" role="list">
      {sections.map((section) => (
        <li><a class="entry-link" href={url(section.href)}>
          <span class="entry-title">{section.title} <span aria-hidden="true">→</span></span>
          <span class="entry-description">{section.description}</span>
        </a></li>
      ))}
    </ul>
  </section>
</Base>
