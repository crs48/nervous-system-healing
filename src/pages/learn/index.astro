---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Lead from "../../components/Lead.astro";
import NextSteps from "../../components/NextSteps.astro";
import { url } from "../../lib/url";

const entries = (await getCollection("garden")).sort(
  (a, b) => a.data.planted.getTime() - b.data.planted.getTime(),
);
---

<Base
  title="Understand"
  description="Plain-language explainers about nervous system states, capacity, and how slow change actually happens."
  crumbs={[]}
>
  <h1 class="page-title">Understand</h1>
  <Lead>
    Plain-language guides to nervous system states, capacity, and change.
    Each article starts with a short summary and can be read on its own.
  </Lead>

  <ul class="entry-list" role="list">
    {
      entries.map((e) => (
        <li>
          <a
            href={url(`learn/${e.id}/`)}
            class="entry-link"
          >
            <p class="entry-title">
              {e.data.title}
            </p>
            <p class="entry-description">
              {e.data.description}
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="guide-section">
    <h2 class="text-2xl mb-3">Further reading</h2>
    <ul class="entry-list" role="list">
      <li><a class="entry-link" href={url("learn/people-and-research/")}>
        <span class="entry-title">People and research</span>
        <span class="entry-description">Irene Lyon, Joe Hudson, Jonny Miller, Bessel van der Kolk, and a few research notes.</span>
      </a></li>
    </ul>
  </section>

  <NextSteps>
    <li><a href={url("start/")}>New here? Start with the path</a></li>
    <li><a href={url("practices/")}>Or try a practice</a></li>
    <li><a href={url("")}>Back home</a></li>
  </NextSteps>
</Base>
