---
import { url } from "../lib/url";
interface Props { tier: "strong" | "moderate" | "preliminary" | "practitioner-reported" | "contested"; }
const { tier } = Astro.props;
const labels = { strong: "strong evidence", moderate: "moderate evidence", preliminary: "preliminary evidence", "practitioner-reported": "practitioner-reported", contested: "contested" };
---
<a href={url("about/criteria/")} class="evidence-tag" data-tier={tier} title="What this evidence grade means">{labels[tier]}</a>
