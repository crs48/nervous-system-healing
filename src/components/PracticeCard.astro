---
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/url";
interface Props { entry: CollectionEntry<"practices">; }
const { entry } = Astro.props;
const d = entry.data;
---
<a href={url(`practices/${entry.id}/`)} class="entry-link">
  <span class="entry-title">{d.title}</span>
  <span class="entry-description">~{d.durationMinutes} min · {d.posture === "any" ? "any position" : d.posture} · {d.soundContent === "none" ? "silent" : d.soundContent}</span>
</a>
