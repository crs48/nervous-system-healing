---
import { url } from "../lib/url";
import { tour } from "../lib/tour";
interface Props { step: number; }
const { step } = Astro.props;
const prev = tour[step - 2];
const next = tour[step];
---
<nav aria-label="Tour navigation" class="step-nav">
  <a href={url(prev ? `start/${prev.slug}/` : "start/")} rel={prev ? "prev" : undefined}>
    ← {prev ? "Previous" : "All steps"}
  </a>
  <span class="step-nav-count">{step} of {tour.length}</span>
  {next ? <a href={url(`start/${next.slug}/`)} rel="next">Next step →</a> : <a href={url("start/")}>All steps</a>}
</nav>
