---
import "../styles/global.css";
import "@fontsource-variable/fraunces/wght.css";
import "@fontsource/atkinson-hyperlegible-next/latin-400.css";
import "@fontsource/atkinson-hyperlegible-next/latin-500.css";
import "@fontsource/atkinson-hyperlegible-next/latin-700.css";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  crumbs?: { label: string; href: string }[];
}
const { title, description, crumbs } = Astro.props;
const nav = [
  { label: "Start here", href: "start/" },
  { label: "Understand", href: "learn/" },
  { label: "Practices", href: "practices/" },
  { label: "Approaches", href: "modalities/" },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {current !== "/404/" && <link rel="canonical" href={new URL(current, Astro.site)} />}
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Gently" href={url("rss.xml")} />
    <title>{title} · Gently</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-name" href={url("")} aria-label="Gently home">gently</a>
        <nav aria-label="Main" class="site-nav">
          {nav.map((item) => (
            <a href={url(item.href)} aria-current={current.startsWith(url(item.href)) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="page" tabindex="-1">
      {crumbs && (
        <nav aria-label="Breadcrumb" class="breadcrumbs">
          <a href={url("")}>Home</a>
          {crumbs.map((c) => (
            <><span aria-hidden="true">/</span><a href={url(c.href)}>{c.label}</a></>
          ))}
          <span aria-hidden="true">/</span><span aria-current="page">{title}</span>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="About this site" class="footer-links">
        <a href={url("about/why/")}>About</a>
        <a href={url("about/criteria/")}>Evidence & criteria</a>
        <a href={url("about/red-flags/")}>Red flags</a>
        <a href="https://github.com/crs48/nervous-system-healing">GitHub</a>
        <a href={url("rss.xml")}>RSS</a>
      </nav>
      <p>A free, open-source guide by <a href="https://crs.land/">Christopher Smothers</a>.{" "}
        <a href="https://github.com/crs48/nervous-system-healing/blob/main/LICENSE">MIT licensed</a>.
      </p>
      <p>Educational content, not medical advice. <a href={url("about/disclaimer/")}>Scope & crisis resources</a>.</p>
    </footer>
  </body>
</html>
